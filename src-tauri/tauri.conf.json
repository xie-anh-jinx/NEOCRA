{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEOCRA",
  "version": "1.0.0",
  "identifier": "com.cra.neocra.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../frontend && TAURI_BUILD=true pnpm build",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "NEOCRA ERP — PT. Cahaya Resource Abadi",
        "width": 1366,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "../frontend/public/logo-cra.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://neocra.pengajaran.com/updates/{{target}}-{{arch}}/latest.json"
      ]
    }
  }
}
